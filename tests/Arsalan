import telebot

API_TOKEN = 'YOUR_API_TOKEN'  # توکن API خود را وارد کنید
bot = telebot.TeleBot(API_TOKEN)

students_info = {}

@bot.message_handler(commands=['start'])
def send_welcome(message):
    bot.reply_to(message, "سلام! نام و نام خانوادگی و شماره دانشجویی خود را وارد کنید.")

@bot.message_handler(func=lambda message: True)
def get_student_info(message):
    chat_id = message.chat.id
    text = message.text
    
    if chat_id in students_info:
        students_info[chat_id]['student_number'] = text
        bot.reply_to(message, "اطلاعات شما ثبت شد.")
    else:
        students_info[chat_id] = {'name': text}
        bot.reply_to(message, "لطفاً شماره دانشجویی خود را وارد کنید.")
    
    # برای نشان دادن اطلاعات دانشجویان در آخر به شما
    print(students_info)

bot.infinity_polling()
